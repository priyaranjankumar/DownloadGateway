{
  "manifest_version": 3,
  "name": "Download Gateway",
  "version": "1.2.0",
  "description": "Send links to your Download Gateway server with one click",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "clipboardRead",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
