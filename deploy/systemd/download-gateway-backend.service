[Unit]
Description=Download Gateway Backend (FastAPI)
After=network.target aria2.service
Requires=aria2.service
Documentation=https://github.com/your-repo/download-gateway

[Service]
Type=simple
User=gateway
Group=gateway
WorkingDirectory=/opt/download-gateway/backend
ExecStart=/opt/download-gateway/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info
Restart=on-failure
RestartSec=5

# Configuration loaded from persistent config file
EnvironmentFile=/etc/download-gateway/config.env

# Security hardening
NoNewPrivileges=no
ProtectHome=yes
ReadWritePaths=/opt/download-gateway/data /downloads /var/log/aria2 /etc/wireguard

[Install]
WantedBy=multi-user.target
