# Download Gateway — persistent configuration
# Generated during install. Edit freely; never overwritten by updates.

# === Secrets (auto-generated on first install) ===
DG_SECRET_KEY=__DG_SECRET_KEY__
DG_ARIA2_RPC_SECRET=__DG_ARIA2_RPC_SECRET__

# === Storage ===
# Primary download directory
DG_DOWNLOAD_DIR=/downloads

# Extra mount points (JSON array of absolute paths)
# Example: DG_EXTRA_DIRS=["/Movies", "/TVShows"]
DG_EXTRA_DIRS=[]

# === Database ===
DG_DATABASE_PATH=/opt/download-gateway/data/gateway.db

# === Logging ===
DG_LOG_LEVEL=INFO
